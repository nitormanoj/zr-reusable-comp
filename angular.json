{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "demo-app": {
      "projectType": "application",
      "root": "projects/demo-app",
      "sourceRoot": "projects/demo-app/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/demo-app",
            "index": "projects/demo-app/src/index.html",
            "main": "projects/demo-app/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/demo-app/tsconfig.app.json",
            "assets": ["projects/demo-app/src/favicon.ico"],
            "styles": ["projects/demo-app/src/styles.scss"],
            "sourceMap": true
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "demo-app:build"
          }
        }
      }
    },
    "ui-table": {
      "projectType": "library",
      "root": "projects/ui-table",
      "sourceRoot": "projects/ui-table/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "project": "projects/ui-table/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ui-table/src/test.ts",
            "karmaConfig": "projects/ui-table/karma.conf.js",
            "tsConfig": "projects/ui-table/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "defaultProject": "demo-app",
  "cli": {
    "analytics": false
  }
}
