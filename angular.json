{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "demo-app": {
      "projectType": "application",
      "root": "projects/demo-app",
      "sourceRoot": "projects/demo-app/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/demo-app"
            },
            "index": "projects/demo-app/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/demo-app/tsconfig.app.json",
            "assets": [
              "projects/demo-app/src/favicon.ico"
            ],
            "styles": [
              "projects/demo-app/src/styles.scss"
            ],
            "sourceMap": true,
            "browser": "projects/demo-app/src/main.ts"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "demo-app:build"
          }
        }
      }
    },
    "ui-table": {
      "projectType": "library",
      "root": "projects/ui-table",
      "sourceRoot": "projects/ui-table/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ui-table/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/ui-table/src/test.ts",
            "karmaConfig": "projects/ui-table/karma.conf.js",
            "tsConfig": "projects/ui-table/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "defaultProject": "demo-app",
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}