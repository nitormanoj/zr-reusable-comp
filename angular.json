{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "demo-app": {
      "projectType": "application",
      "root": "projects/demo-app",
      "sourceRoot": "projects/demo-app/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/demo-app",
            "index": "projects/demo-app/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/demo-app/tsconfig.app.json",
            "assets": [
              "projects/demo-app/src/favicon.ico"
            ],
            "styles": [
              "projects/demo-app/src/styles.scss"
            ],
            "sourceMap": true,
            "main": "projects/demo-app/src/main.ts"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "demo-app:build"
          }
        },
         "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "demo-app:build",
            "port": 6006,
            "compodoc": false,
            "styles": [
              ".storybook/preview.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "demo-app:build",
            "outputDir": "storybook-static",
            "compodoc": false,
            "styles": [
              ".storybook/preview.css"
            ]
          }
        }
      }
    },
    "zr-components": {
      "projectType": "library",
      "root": "projects/zr-components",
      "sourceRoot": "projects/zr-components/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/zr-components/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/zr-components/src/test.ts",
            "karmaConfig": "projects/zr-components/karma.conf.js",
            "tsConfig": "projects/zr-components/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}